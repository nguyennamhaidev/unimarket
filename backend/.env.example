# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL="https://your-frontend-domain.onrender.com"

# Security
JWT_SECRET="unimarket_super_secret_student_jwt_key_2026"

# Database Configuration (PostgreSQL on Supabase / Render PostgreSQL)
# Local development: "file:./dev.db"
# Production: "postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
DATABASE_URL="file:./dev.db"

# Cloud Storage Options (Choose Supabase Storage or Cloudinary to preserve uploaded images across Render restarts)
# Option 1: Supabase Storage (Recommended)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="unimarket-images"

# Option 2: Cloudinary (Alternative)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
